# Copy to backend/.env. Never commit or share actual keys.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated frontend origins, with no trailing slash. No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dashboard > Project settings / API. Server-only service_role or secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-or-secret-key
# Already created by supabase/init.sql; private, served through Node.
SUPABASE_STORAGE_BUCKET=assets
# Custom JWT auth; NOT your Supabase key.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=mit-clubs-api
JWT_AUDIENCE=mit-clubs-web
JWT_ACCESS_TTL_SECONDS=900
# Session absolute lifetime; rotating tokens do not extend beyond it.
AUTH_SESSION_DAYS=30
# Defaults to true in production and false locally. Production requires HTTPS.
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# Atomic auth uses service-role-only functions in supabase/auth_functions.sql.
# Run that additive migration; no DATABASE_URL is needed.
# Required in production; optional locally (local uses in-memory rate limits).
# Redis Cloud/Upstash: use the Redis connection URL (rediss:// for TLS),
# not an HTTPS REST endpoint. Keep username/password in this server-only file.
# REDIS_URL=redis://localhost:6379
# PostHog browser analytics is configured in the ROOT .env, see /.env.example.
