# Optional PUBLIC backend origin for separate-origin deployments. No API keys here.
# Leave blank for the Vite dev proxy / a same-origin production reverse proxy.
VITE_API_BASE_URL=

# Public PostHog project token (phc_...), NOT a personal API key.
# Leave blank to disable analytics. Copy host from your PostHog project setup.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
